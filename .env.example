# Store-scoped Admin API base: <admin origin>/api/<storeId>. Used by most data fetches and the COD checkout.
NEXT_PUBLIC_API_URL=

# Admin API root, without a Store id: <admin origin>/api. Used only to read the Store (name, logo, favicon).
NEXT_PUBLIC_API_BASE_URL=

# The Store this deployment shows (a Store id from Admin).
NEXT_PUBLIC_STORE_ID=

# Optional: WhatsApp number for the floating button, digits only with country code. No button when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
